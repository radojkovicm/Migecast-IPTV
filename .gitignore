# --- Private user data: NEVER commit -------------------------------------
# Databases, playlists, logs, caches and keys contain IPTV credentials and
# stream URLs. The app stores them in %LOCALAPPDATA%\MigeCast, never here.
data/
cache/
logs/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.log
*.m3u
*.m3u8
!tests/fixtures/*.m3u
!tests/fixtures/*.m3u8
.env
*.env
secret.key
config.json
config.ini
project_structure.txt

