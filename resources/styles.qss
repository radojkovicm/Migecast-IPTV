/* MigeCast IPTV - Global Stylesheet */

/* Main window */
QMainWindow {
    background-color: #f5f5f5;
}

/* Buttons */
QPushButton {
    font-size: 14pt;
    padding: 10px 20px;
    background-color: white;
    border: 2px solid #ccc;
    border-radius: 5px;
    color: #1a1a1a;
}

QPushButton:hover {
    background-color: #e0e0e0;
    border-color: #999;
}

QPushButton:pressed {
    background-color: #d0d0d0;
}

QPushButton:disabled {
    background-color: #f0f0f0;
    color: #999;
}

/* Input fields */
QLineEdit, QTextEdit {
    font-size: 14pt;
    padding: 8px;
    border: 2px solid #ccc;
    border-radius: 5px;
    background-color: white;
    color: #1a1a1a;
}

QLineEdit:focus, QTextEdit:focus {
    border-color: #4CAF50;
}

/* ComboBox */
QComboBox {
    font-size: 14pt;
    padding: 8px;
    border: 2px solid #ccc;
    border-radius: 5px;
    background-color: white;
}

QComboBox::drop-down {
    border: none;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #666;
    margin-right: 10px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: #f0f0f0;
    width: 15px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #999;
    min-height: 30px;
    border-radius: 7px;
}

QScrollBar::handle:vertical:hover {
    background-color: #666;
}

QScrollBar:horizontal {
    border: none;
    background-color: #f0f0f0;
    height: 15px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #999;
    min-width: 30px;
    border-radius: 7px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #666;
}

/* Sliders */
QSlider::groove:horizontal {
    border: 1px solid #999;
    height: 8px;
    background-color: #e0e0e0;
    margin: 2px 0;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background-color: #4CAF50;
    border: 1px solid #4CAF50;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #45a049;
}

/* Labels */
QLabel {
    color: #1a1a1a;
}

/* GroupBox */
QGroupBox {
    font-size: 14pt;
    font-weight: bold;
    border: 2px solid #ccc;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    color: #4CAF50;
}

/* Checkbox */
QCheckBox {
    font-size: 14pt;
    spacing: 10px;
}

QCheckBox::indicator {
    width: 25px;
    height: 25px;
    border: 2px solid #ccc;
    border-radius: 5px;
    background-color: white;
}

QCheckBox::indicator:checked {
    background-color: #4CAF50;
    border-color: #4CAF50;
}

/* SpinBox */
QSpinBox {
    font-size: 14pt;
    padding: 8px;
    border: 2px solid #ccc;
    border-radius: 5px;
    background-color: white;
}